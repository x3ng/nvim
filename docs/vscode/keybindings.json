[
  {
    "key": "ctrl+a",
    "command": "cursorHome",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+e",
    "command": "cursorEnd",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+b",
    "command": "cursorLeft",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+f",
    "command": "cursorRight",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+n",
    "command": "cursorDown",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+p",
    "command": "cursorUp",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+d",
    "command": "deleteRight",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+k",
    "command": "deleteAllRight",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "alt+b",
    "command": "cursorWordLeft",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "alt+f",
    "command": "cursorWordRight",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "alt+d",
    "command": "deleteWordRight",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "alt+backspace",
    "command": "deleteWordLeft",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  },
  {
    "key": "ctrl+alt+h",
    "command": "deleteWordLeft",
    "when": "editorTextFocus && neovim.init && neovim.mode == insert"
  }
]
